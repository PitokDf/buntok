  "scripts": {
    "test": "bun test tests",
    "test:watch": "bun test --watch tests",
    "test:unit": "bun test tests/helpers tests/middlewares",
    "test:integration": "bun test tests/combinations.test.ts tests/context.test.ts",
    "test:server": "bun run test/src/index.ts",
    "build": "tsup && bun run fix-node-prefix && bun run build:types && bun run build:dcts && mkdir -p dist/cli/templates && cp src/cli/templates/* dist/cli/templates/",
    "build:types": "bunx tsc --project tsconfig.build.json",
    "build:dcts": "cd dist && find . -name '*.d.ts' -not -name '*.d.ts.map' | while read f; do cp \"$f\" \"${f%.d.ts}.d.cts\"; done && find . -name '*-exports.d.ts' -not -name '*.d.ts.map' | while read f; do clean=\"$(echo \"$f\" | sed 's/-exports\\.d\\.ts$/.d.ts/')\"; cp \"$f\" \"$clean\"; done && find . -name '*-exports.d.cts' -not -name '*.d.ts.map' | while read f; do clean=\"$(echo \"$f\" | sed 's/-exports\\.d\\.cts$/.d.cts/')\"; cp \"$f\" \"$clean\"; done",
    "fix-node-prefix": "bun scripts/fix-node-prefix.ts",
    "postbuild": "bun run sync-deps",
    "sync-deps": "bun scripts/sync-local-deps.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "ci": "bun run typecheck && bun test tests && bun run build",
    "clean": "rm -rf dist"
  },
