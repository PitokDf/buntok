	"files": [
		"dist",
		"public",
		"scripts",
		"README.md"
	],
	"scripts": {
		"test": "bun test tests",
		"test:watch": "bun test --watch tests",
		"test:unit": "bun test tests/helpers tests/middlewares",
		"test:integration": "bun test tests/combinations.test.ts tests/context.test.ts",
		"test:server": "bun run test/src/index.ts",
		"build": "tsup && bun run fix-node-prefix && bun run build:types && bun run build:dcts && mkdir -p dist/cli/templates && cp src/cli/templates/* dist/cli/templates/",
		"build:types": "bunx tsc --project tsconfig.build.json",
		"build:dcts": "cd dist && find . -name '*.d.ts' -not -name '*.d.ts.map' | while read f; do cp \"$f\" \"${f%.d.ts}.d.cts\"; done",
		"fix-node-prefix": "bun scripts/fix-node-prefix.ts",
		"postbuild": "bun run sync-deps",
		"sync-deps": "bun scripts/sync-local-deps.ts",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"ci": "bun run typecheck && bun test tests && bun run build",
		"clean": "rm -rf dist"
	},
	"devDependencies": {
		"@types/amqplib": "^0.10.8",
		"@types/bun": "latest",
		"reflect-metadata": "^0.2.2",
		"tsup": "^8.5.1",
		"typescript": "^5.0.0"
	},
	"keywords": [
		"bun",
		"framework",
		"web",
		"api",
		"typescript",
		"http",
		"express"
	],
	"author": "Pitok",
	"license": "MIT",
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^8.5.0",
		"croner": "^10.0.1",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"bun": ">=1.2.0",
		"@apollo/server": ">=4.0.0",
		"graphql": ">=16.0.0",
		"graphql-yoga": ">=5.0.0",
		"@opentelemetry/api": ">=1.0.0",
		"ioredis": "",
		"bullmq": "",
		"amqplib": "",
		"reflect-metadata": ">=0.1.0"
	},
	"peerDependenciesMeta": {
		"@apollo/server": {
