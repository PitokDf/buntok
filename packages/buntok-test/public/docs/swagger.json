    "/schema-demo/validate": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "description": "Full name"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email address"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "description": "Password"
                  },
                  "bio": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "website": {
                    "type": "string",
                    "format": "uri"
                  },
                  "birthday": {
                    "type": "string",
                    "format": "date"
                  },
                  "avatar_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "age": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 150,
                    "description": "User age"
                  },
                  "score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Score percentage"
                  },
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90,
                    "description": "Latitude coordinate"
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180,
                    "description": "Longitude coordinate"
                  },
                  "is_active": {
                    "type": "boolean",
                    "default": true,
                    "description": "Account active status"
                  },
                  "is_admin": {
                    "type": "boolean",
                    "default": false,
                    "description": "Admin privileges"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "active",
                      "inactive",
                      "pending"
                    ],
                    "default": "active",
                    "description": "Account status"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "user",
                      "editor",
                      "admin"
                    ],
                    "default": "user",
                    "description": "User role"
                  },
                  "preferred_language": {
                    "type": "string",
                    "enum": [
                      "en",
                      "id",
                      "ja",
                      "ko"
                    ],
                    "default": "en",
                    "description": "Preferred language"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "scores": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "required": [
                  "name",
                  "email",
                  "password",
                  "age",
                  "score",
                  "latitude",
                  "longitude"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/schema-demo/pets": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "name",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "nullable": true,
              "minimum": 0
            },
            "required": false,
            "name": "age_min",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "nullable": true,
              "maximum": 100
            },
            "required": false,
            "name": "age_max",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "dog",
                "cat",
                "bird",
                "fish"
              ]
            },
            "required": false,
            "name": "species",
            "in": "query"
          },
          {
            "schema": {
              "type": "boolean",
              "nullable": true
            },
            "required": false,
            "name": "is_vaccinated",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "nullable": true
            },
            "required": false,
            "name": "tags",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/schema-demo/complex": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "email": {
                        "type": "string",
                        "format": "email"
                      },
                      "profile": {
                        "type": "object",
                        "properties": {
                          "age": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 150
                          },
                          "bio": {
                            "type": "string",
                            "maxLength": 500
                          },
                          "social": {
                            "type": "object",
                            "properties": {
                              "twitter": {
                                "type": "string",
                                "format": "uri"
                              },
                              "github": {
                                "type": "string",
                                "format": "uri"
                              }
                            }
                          }
                        },
                        "required": [
                          "age"
                        ]
                      }
                    },
                    "required": [
                      "name",
                      "email",
                      "profile"
                    ]
                  },
                  "settings": {
                    "type": "object",
                    "properties": {
                      "theme": {
                        "type": "string",
                        "enum": [
                          "light",
                          "dark",
                          "system"
                        ],
                        "default": "system"
                      },
                      "notifications": {
                        "type": "object",
                        "properties": {
                          "email": {
                            "type": "boolean",
                            "default": true
                          },
                          "push": {
                            "type": "boolean",
                            "default": true
                          },
                          "sms": {
                            "type": "boolean",
                            "default": false
                          }
                        }
                      },
                      "language": {
                        "type": "string",
                        "enum": [
                          "en",
                          "id"
                        ],
                        "default": "en"
                      }
                    },
                    "required": [
                      "notifications"
                    ]
                  },
                  "friends": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "email"
                    }
                  },
                  "addresses": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "description": "Address label (e.g. Home, Office)"
                        },
                        "street": {
                          "type": "string",
                          "description": "Street address"
                        },
                        "city": {
                          "type": "string",
                          "description": "City"
                        },
                        "zip": {
                          "type": "string",
                          "description": "ZIP / Postal code"
                        },
                        "isDefault": {
                          "type": "boolean",
                          "default": false,
                          "description": "Use as primary address"
                        }
                      },
                      "required": [
                        "label",
                        "street",
                        "city",
                        "zip"
                      ]
                    }
                  },
                  "scores": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  }
                },
                "required": [
                  "user",
                  "settings"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/schema-demo/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/schema-demo/upload": {
      "post": {
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Your name"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email address"
                  },
                  "age": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0,
                    "maximum": 150,
                    "description": "Your age"
                  },
                  "bio": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "admin",
                      "user",
                      "guest"
                    ],
                    "default": "user",
                    "description": "User role"
                  },
                  "is_active": {
                    "type": "boolean",
                    "nullable": true,
                    "default": true,
                    "description": "Account active status"
                  },
                  "scores": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "nullable": true,
                      "minimum": 0,
                      "maximum": 100
                    }
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "avatar": {
                    "type": "string",
                    "format": "binary",
                    "description": "Binary file"
                  }
                },
                "required": [
                  "name",
                  "email",
                  "age"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  }
}